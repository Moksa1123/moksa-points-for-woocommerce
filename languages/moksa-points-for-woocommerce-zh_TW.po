#: src/Modules/Abilities/Ability.php:265
#: src/Modules/Abilities/Ability.php:486
#: src/Modules/Abilities/Ability.php:522
#: src/Modules/Abilities/Ability.php:581
msgid "Customer user_id"
msgstr "顧客 user_id"

#: src/Modules/Abilities/Ability.php:201
msgid "Customer email (used when user_id is omitted)"
msgstr "顧客電子郵件 (未提供 user_id 時使用)"

#: src/Modules/Abilities/Ability.php:222
msgid "Get points balance"
msgstr "查點數餘額"

#: src/Modules/Abilities/Ability.php:223
msgid "Get a customer's current points and store credit balance (provide user_id or email). Read-only."
msgstr "查某位顧客目前的點數與儲值金餘額(可給 user_id 或 email)。唯讀。"

#: src/Modules/Abilities/Ability.php:230
msgid "Customer user_id (or email)"
msgstr "顧客 user_id(與 email 二擇一)"

#: src/Modules/Abilities/Ability.php:234
msgid "Customer email (used when user_id is unavailable)"
msgstr "顧客 email(找不到 user_id 時用)"

#: src/Modules/Abilities/Ability.php:257
msgid "Get points history"
msgstr "查點數異動紀錄"

#: src/Modules/Abilities/Ability.php:258
msgid "Get a customer's points / store credit ledger history (paginated, default 20, max 200). Read-only."
msgstr "取某位顧客的點數 / 儲值金帳本異動紀錄(分頁,預設 20 筆、上限 200)。唯讀。"

#: src/Modules/Abilities/Ability.php:269
msgid "Customer email (or user_id)"
msgstr "顧客 email(與 user_id 二擇一)"

#: src/Modules/Abilities/Ability.php:273
msgid "Maximum number of records (default 20, max 200)"
msgstr "最多幾筆(預設 20,上限 200)"

#: src/Modules/Abilities/Ability.php:277
msgid "Offset (for pagination, default 0)"
msgstr "位移(分頁用,預設 0)"

#: src/Modules/Abilities/Ability.php:293
msgid "Signed points change (+earned / -spent)."
msgstr "帶正負號的點數異動 (+賺得 / -花費)。"

#: src/Modules/Abilities/Ability.php:294
msgid "Signed store-credit change."
msgstr "帶正負號的儲值金異動。"

#: src/Modules/Abilities/Ability.php:296
msgid "earn / redeem / expire / adjust / debit."
msgstr "earn / redeem / expire / adjust / debit。"

#: src/Modules/Abilities/Ability.php:299
msgid "UTC time, Y-m-d H:i:s."
msgstr "UTC 時間,格式 Y-m-d H:i:s。"

#: src/Modules/Abilities/Ability.php:314
msgid "List earning rules"
msgstr "列出集點規則"

#: src/Modules/Abilities/Ability.php:315
msgid "List configured earning rules (spend N → Y points, multiplier, campaign period). Read-only."
msgstr "列出已設定的賺點規則(消費 N → Y 點、倍率、活動期間)。唯讀。"

#: src/Modules/Abilities/Ability.php:322
msgid "List only enabled rules (default false = all)"
msgstr "只列啟用中的規則(預設 false = 全部)"

#: src/Modules/Abilities/Ability.php:340
msgid "Points per 1 currency unit for this rule."
msgstr "此規則每 1 元可得的點數。"

#: src/Modules/Abilities/Ability.php:344
msgid "1 = enabled, 0 = disabled."
msgstr "1 = 啟用,0 = 停用。"

#: src/Modules/Abilities/Ability.php:361
msgid "List redemption items"
msgstr "列出兌換項目"

#: src/Modules/Abilities/Ability.php:362
msgid "List items customers can redeem with points (coupon / cart discount / product) and the points required. Read-only."
msgstr "列出顧客可用點數兌換的項目(優惠券 / 購物車折抵 / 商品)及所需點數。唯讀。"

#: src/Modules/Abilities/Ability.php:369
msgid "List only enabled redemption items (default false = all)"
msgstr "只列啟用中的兌換項目(預設 false = 全部)"

#: src/Modules/Abilities/Ability.php:386
msgid "coupon / cart_discount / product."
msgstr "coupon / cart_discount / product。"

#: src/Modules/Abilities/Ability.php:388
msgid "1 = listed, 0 = delisted."
msgstr "1 = 已上架,0 = 已下架。"

#: src/Modules/Abilities/Ability.php:389
msgid "Remaining stock (-1 = unlimited)."
msgstr "剩餘庫存 (-1 = 無限)。"

#: src/Modules/Abilities/Ability.php:404
msgid "Points operations report"
msgstr "點數營運報表"

#: src/Modules/Abilities/Ability.php:405
msgid "Summarize total points and store credit issued / redeemed / expired, plus points currently in circulation. Read-only."
msgstr "彙總已發放 / 已兌換 / 已到期的總點數與儲值金,以及目前流通中的點數。唯讀。"

#: src/Modules/Abilities/Ability.php:412
msgid "Cover the last N days (omit = all time)"
msgstr "統計近 N 天(不給 = 全部期間)"

#: src/Modules/Abilities/Ability.php:437
msgid "Get points settings"
msgstr "讀取點數設定"

#: src/Modules/Abilities/Ability.php:438
msgid "Return the current values of the store's whitelisted points settings (points per dollar, redemption ratio, points unit name, email appearance, front-end message templates, etc.), including type and description. Read-only; excludes any security / MCP / cap settings."
msgstr "回傳一份白名單內的店家點數設定目前值(每元給幾點、折抵比例、點數單位名、信件外觀、各前台訊息範本等),含型別與說明。唯讀;不含任何安全 / MCP / cap 設定。"

#: src/Modules/Abilities/Ability.php:452
msgid "Each entry is a whitelisted setting of {key, label, type, value}."
msgstr "每筆為 {key, label, type, value} 的白名單設定。"

#: src/Modules/Abilities/Ability.php:456
msgid "Option key (pass to update-setting)."
msgstr "選項鍵值 (可傳給 update-setting)。"

#: src/Modules/Abilities/Ability.php:458
msgid "Value type hint: string / number / boolean."
msgstr "值的型別提示:string / number / boolean。"

#: src/Modules/Abilities/Ability.php:459
msgid "Current value (type per the \"type\" field)."
msgstr "目前的值 (型別依「type」欄位)。"

#: src/Modules/Abilities/Ability.php:478
msgid "Manually adjust points"
msgstr "人工調整點數"

#: src/Modules/Abilities/Ability.php:479
msgid "Manually add / deduct points for a customer (positive adds, negative deducts). Destructive, idempotent (the same bucket is not posted twice)."
msgstr "為某位顧客手動加 / 扣點數(正數加、負數扣)。破壞性、冪等(同一 bucket 不重複入帳)。"

#: src/Modules/Abilities/Ability.php:490
msgid "Points to add / deduct (positive adds, negative deducts)"
msgstr "加 / 扣的點數(正數加、負數扣)"

#: src/Modules/Abilities/Ability.php:494
msgid "Reason for the adjustment (shown in the customer's history)"
msgstr "調整原因(顯示於顧客的異動紀錄)"

#: src/Modules/Abilities/Ability.php:498
msgid "Idempotency key (the same key is not posted twice; defaults to the current time if omitted)"
msgstr "冪等鍵(同一鍵不重複入帳;不給則用當下時間)"

#: src/Modules/Abilities/Ability.php:514
#: src/Modules/MyAccount/RedeemCode.php:47
msgid "Redeem points"
msgstr "兌換點數"

#: src/Modules/Abilities/Ability.php:515
msgid "Redeem a reward with a customer's points (coupon / cart discount / product). Destructive — requires the \"Redeem\" module to be enabled; mints a real coupon when moforcoupon is present, otherwise skips gracefully."
msgstr "用顧客的點數兌換一項獎勵(優惠券 / 購物車折抵 / 商品)。破壞性 —— 需啟用「兌換」模組;moforcoupon 在場時會鑄出真實優惠券,否則優雅略過。"

#: src/Modules/Abilities/Ability.php:527
msgid "Redemption type: coupon / cart_discount / product"
msgstr "兌換類型:coupon(優惠券)/ cart_discount(購物車折抵)/ product(商品)"

#: src/Modules/Abilities/Ability.php:531
msgid "Redemption catalog item id (optional)"
msgstr "兌換目錄項目 id(選填)"

#: src/Modules/Abilities/Ability.php:535
msgid "Points to deduct for this redemption (optional; defaults to the catalog setting)"
msgstr "本次兌換扣除的點數(選填,未給則取目錄設定)"

#: src/Modules/Abilities/Ability.php:551
msgid "Transfer points between customers"
msgstr "在顧客之間轉移點數"

#: src/Modules/Abilities/Ability.php:552
msgid "Move points from one customer to another (amount-conserving, per-user locked). Destructive."
msgstr "把點數從一位顧客轉給另一位 (總量守恆,逐人上鎖)。具破壞性。"

#: src/Modules/Abilities/Ability.php:557
msgid "Sender user_id"
msgstr "轉出者 user_id"

#: src/Modules/Abilities/Ability.php:558
msgid "Recipient user_id"
msgstr "接收者 user_id"

#: src/Modules/Abilities/Ability.php:559
msgid "Points to transfer (positive)"
msgstr "要轉移的點數 (正數)"

#: src/Modules/Abilities/Ability.php:560
msgid "Optional note shown in both histories"
msgstr "選填備註,會顯示在雙方的紀錄中"

#: src/Modules/Abilities/Ability.php:575
msgid "Manually adjust store credit"
msgstr "手動調整儲值金"

#: src/Modules/Abilities/Ability.php:576
msgid "Manually add or deduct a customer store-credit balance (currency; positive adds, negative deducts). Destructive, idempotent on the bucket."
msgstr "手動增加或扣除顧客的儲值金餘額 (以貨幣計;正數增加、負數扣除)。具破壞性,以 bucket 為冪等鍵。"

#: src/Modules/Abilities/Ability.php:582
msgid "Store-credit change (positive adds, negative deducts)"
msgstr "儲值金異動 (正數增加、負數扣除)"

#: src/Modules/Abilities/Ability.php:583
msgid "Reason (shown in history)"
msgstr "原因 (會顯示在紀錄中)"

#: src/Modules/Abilities/Ability.php:584
msgid "Idempotency key (defaults to current time)"
msgstr "冪等鍵 (預設為目前時間)"

#: src/Modules/Abilities/Ability.php:599
msgid "Create a redemption reward"
msgstr "建立兌換獎勵"

#: src/Modules/Abilities/Ability.php:600
msgid "Add a new item to the points redemption catalog (label, kind, cost). Destructive."
msgstr "在點數兌換型錄中新增項目 (名稱、種類、所需點數)。具破壞性。"

#: src/Modules/Abilities/Ability.php:605
#: src/Modules/Abilities/Ability.php:631
msgid "Reward catalog id (required for update)"
msgstr "兌換型錄 id (更新時必填)"

#: src/Modules/Abilities/Ability.php:606
#: src/Modules/Abilities/Ability.php:632
msgid "Reward name shown to customers"
msgstr "顯示給顧客的獎勵名稱"

#: src/Modules/Abilities/Ability.php:607
#: src/Modules/Abilities/Ability.php:633
msgid "coupon / cart_discount / product"
msgstr "coupon / cart_discount / product"

#: src/Modules/Abilities/Ability.php:608
#: src/Modules/Abilities/Ability.php:634
msgid "Points required to redeem"
msgstr "兌換所需點數"

#: src/Modules/Abilities/Ability.php:609
#: src/Modules/Abilities/Ability.php:635
msgid "Remaining stock (-1 = unlimited)"
msgstr "剩餘庫存 (-1 = 無限)"

#: src/Modules/Abilities/Ability.php:610
#: src/Modules/Abilities/Ability.php:636
msgid "1 = listed, 0 = delisted"
msgstr "1 = 已上架,0 = 已下架"

#: src/Modules/Abilities/Ability.php:625
msgid "Update a redemption reward"
msgstr "更新兌換獎勵"

#: src/Modules/Abilities/Ability.php:626
msgid "Update an existing redemption catalog item by id (only provided fields change). Destructive."
msgstr "依 id 更新既有的兌換型錄項目 (只有提供的欄位會變動)。具破壞性。"

#: src/Modules/Abilities/Ability.php:651
msgid "Reverse points earned on an order"
msgstr "回收訂單已賺得的點數"

#: src/Modules/Abilities/Ability.php:652
msgid "Claw back the points a customer earned for a specific order (as on a refund). Balance never goes below zero. Destructive, idempotent."
msgstr "把顧客在特定訂單賺得的點數收回 (等同退款時的處理)。餘額絕不會低於零。具破壞性且冪等。"

#: src/Modules/Abilities/Ability.php:657
msgid "Order id whose earned points should be reversed"
msgstr "要回收賺得點數的訂單 id"

#: src/Modules/Abilities/Ability.php:672
msgid "Run points expiry scan"
msgstr "執行點數到期掃描"

#: src/Modules/Abilities/Ability.php:673
msgid "Run a one-off expiry sweep now (deduct and record points past expires_at). Destructive, irreversible."
msgstr "立即執行一次到期點數清掃(把已過 expires_at 的點數扣除並記帳)。破壞性、不可逆。"

#: src/Modules/Abilities/Ability.php:680
msgid "Scan only one customer (omit = all customers)"
msgstr "只掃某位顧客(不給 = 全部顧客)"

#: src/Modules/Abilities/Ability.php:696
msgid "Update points settings"
msgstr "修改點數設定"

#: src/Modules/Abilities/Ability.php:697
msgid "Update one whitelisted store points setting (key + value). The value is sanitized / validated according to the setting's type (numeric clamped to range, yes/no, hex color, string) before saving. Destructive — non-whitelisted keys are always rejected; never accepts any security / MCP / cap settings."
msgstr "修改一項白名單內的店家點數設定(key + value)。value 會依該設定型別 sanitize / validate(數值夾範圍、yes/no、hex 色碼、字串)後寫入。破壞性 —— 非白名單 key 一律拒絕;絕不接受任何安全 / MCP / cap 設定。"

